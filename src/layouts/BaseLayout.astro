---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_TITLE, SITE_DESCRIPTION, GOATCOUNTER_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Set on lesson pages so search engines see an Article, not a WebPage. */
  jsonLd?: Record<string, unknown> | null;
  /**
   * 'lesson' switches to the fixed app shell: header and left rail stay put,
   * only the article column scrolls. Everything else keeps normal document
   * scrolling, which is right for the homepage and the marketing-ish pages.
   */
  shell?: 'page' | 'lesson';
}
const { title, description = SITE_DESCRIPTION, jsonLd = null, shell = 'page' } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE} | Stop prompting. Start building agentic graphs.`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Social cards need an absolute URL and a format every scraper reads, which is
// why this is a PNG while the on-page covers are WebP. Built from the same
// source art by scripts/import_covers.py.
const ogImage = new URL(`${base}/og-cover.png`, Astro.site ?? Astro.url).href;
// Canonical must resolve against the configured production site, not the host
// that happened to render the page. Astro.url alone is correct in CI but
// points at localhost in dev, which is how a dev canonical ships by accident.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Brian Baldock" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={jsonLd ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Graph Engineering: stop prompting, start building agentic graphs." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    {/*
      GoatCounter: cookieless analytics, no consent banner required.
      is:inline is mandatory here. Astro would otherwise bundle this script
      and strip the data-goatcounter attribute the beacon reads, which is the
      exact failure mode that silently produces zero pageviews.
      Rendered only when GOATCOUNTER_URL is set, so disabling is one edit.
    */}
    {GOATCOUNTER_URL && (
      <script
        is:inline
        data-goatcounter={GOATCOUNTER_URL}
        async
        src="//gc.zgo.at/count.js"></script>
    )}
  </head>
  <body class={shell === 'lesson' ? 'shell-fixed' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" style="border-bottom:1px solid var(--border);background:var(--bg-elev)">
      <div class="wrap" style="display:flex;align-items:center;gap:1.25rem;padding-top:.8rem;padding-bottom:.8rem;flex-wrap:wrap">
        <a href={`${base}/`} style="font-weight:700;color:var(--fg);text-decoration:none">
          <span style="color:var(--accent)">◆</span> {SITE_TITLE}
        </a>
        <nav style="display:flex;gap:1rem;font-size:.92rem;margin-left:auto;align-items:center">
          <a href={`${base}/lessons/`}>Lessons</a>
          <a href={`${base}/setup/`}>Setup</a>
          <a href={`${base}/projects/`}>Projects</a>
          <button id="theme-toggle" type="button" aria-label="Toggle colour theme"
            style="background:none;border:1px solid var(--border);border-radius:6px;color:var(--fg);cursor:pointer;padding:.2rem .5rem;font-size:.85rem">
            ☾/☀
          </button>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    {/*
      In the fixed lesson shell the footer has to live inside the scrolling
      column, otherwise it sits permanently across the bottom of the viewport
      eating vertical space on every lesson. LessonLayout renders its own
      copy at the end of the article instead.
    */}
    {shell !== 'lesson' && (
    <footer style="border-top:1px solid var(--border);margin-top:4rem;padding:2rem 0;color:var(--fg-muted);font-size:.87rem">
      <SiteFooter />
    </footer>
    )}

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme');
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
