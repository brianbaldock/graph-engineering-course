---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Not found">
  <div class="wrap prose-wrap" style="padding-top:4rem;text-align:center">
    <h1>404</h1>
    <p class="muted">No edge leads here.</p>
    <p><a href={`${base}/lessons/`}>Browse the lessons</a></p>
  </div>
</BaseLayout>
