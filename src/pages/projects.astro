---
// Brian's other work, as a real page rather than a footer afterthought.
//
// Every `url:` here is checked for reachability by scripts/verify_citations.py,
// and every `shot:` is checked for existence by the same script. The regexes it
// uses key off those two literal field names, so if you rename them, update the
// verifier or the check silently passes over nothing. That exact failure (a gate
// that scans zero files and reports success) is what Lesson 6 is about.
//
// Screenshots are committed artifacts regenerated by hand with
// scripts/shoot_projects.py, not a CI side effect. These sites change on their
// own schedule and a build should never quietly rewrite what this page shows.
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const projects = [
  {
    name: 'Notes from the workshop',
    url: 'https://blog.brianbaldock.net',
    shot: '/projects/blog.webp',
    alt: 'Homepage of Notes from the workshop, showing a featured post and a list of recent writing.',
    tag: 'Blog',
    blurb:
      'Security, AI infrastructure, and what building in the open actually teaches you. Mostly writeups of things that broke and what the fix turned out to be, which is the part usually left out.',
    why:
      'This course started as a blog-shaped argument that got too long. If you want the shorter pieces, or you want to find me anywhere else, start here.',
  },
  {
    name: 'AIgregator',
    url: 'https://aigregator.news',
    shot: '/projects/aigregator.webp',
    alt: 'The AIgregator homepage, showing the daily AI news digest with scored and clustered stories.',
    tag: 'Daily digest',
    blurb:
      'A daily AI news digest. Frontier-lab releases, policy moves, and prediction markets, clustered and scored, with every item linking to its source.',
    why:
      'Built for the same reason as Lesson 0: most AI news is a retelling of a retelling. Every claim here keeps its citation attached so you can check it yourself.',
  },
];
---
<BaseLayout
  title="Other projects"
  description="Brian Baldock's other work: Notes from the workshop, and AIgregator, the daily AI news digest."
>
  <section class="wrap" style="padding:3.5rem 1.25rem 0;max-width:52rem">
    <p class="pill">Elsewhere</p>
    <h1 style="font-size:2.2rem;margin-top:1rem">Other projects</h1>
    <p style="font-size:1.1rem;color:var(--fg-muted);margin-top:.4rem">
      Two other things I keep running. Both are built the same way this course was:
      in public, with the sources attached.
    </p>
  </section>

  <section class="wrap projects" style="max-width:52rem">
    {projects.map((p) => (
      <article class="project card">
        <a class="shot" href={p.url} rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
          <img src={`${base}${p.shot}`} alt="" width="1280" height="800" loading="lazy" decoding="async" />
        </a>
        <div class="body">
          <p class="tag">{p.tag}</p>
          <h2><a href={p.url} rel="noopener noreferrer">{p.name}</a></h2>
          <p>{p.blurb}</p>
          <p class="why">{p.why}</p>
        </div>
      </article>
    ))}
  </section>

  <section class="wrap" style="max-width:52rem;margin-top:2rem">
    <p style="color:var(--fg-muted);font-size:.9rem">
      Screenshots were captured by hand and show these sites as they looked when this
      page was last updated. They are not live, and both sites change more often than
      this page does. <a href={`${base}/lessons/`}>Back to the lessons.</a>
    </p>
  </section>
</BaseLayout>

<style>
  .projects {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .project {
    padding: 0;
    overflow: hidden;
  }
  .shot {
    display: block;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elev);
  }
  /* The captures are 1280x800 above the fold. In the narrow card column the
     image has to be cropped somewhere, and centre-cropping clipped both sites'
     left edges: the blog's "I'm Brian" heading and AIgregator's masthead both
     start hard against the left margin. Anchoring top-left keeps the part of
     each page that identifies it and takes the crop off the right and bottom,
     which is body content the card is not trying to show anyway. */
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 8;
    object-fit: cover;
    object-position: left top;
  }
  .body {
    padding: 1.25rem 1.4rem 1.4rem;
  }
  .tag {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .project h2 {
    margin: 0.35rem 0 0.6rem;
    font-size: 1.3rem;
  }
  .project h2 a {
    color: var(--fg);
    text-decoration: none;
  }
  .project h2 a:hover {
    color: var(--accent-strong);
    text-decoration: underline;
  }
  .project p {
    margin: 0 0 0.7rem;
    line-height: 1.55;
  }
  .why {
    color: var(--fg-muted);
    font-size: 0.92rem;
    margin-bottom: 0 !important;
  }
  @media (min-width: 900px) {
    .project {
      display: grid;
      grid-template-columns: 42% 1fr;
      align-items: stretch;
    }
    .shot {
      border-bottom: none;
      border-right: 1px solid var(--border);
      height: 100%;
    }
    .shot img {
      height: 100%;
      aspect-ratio: auto;
    }
  }
</style>
