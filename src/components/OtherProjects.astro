---
// Brian's other work. Shown in the footer on every page.
//
// Every URL here is checked by scripts/verify_citations.py alongside the
// lesson sources, so a link that dies fails the build instead of sitting
// broken on a site that lectures people about verification.
const projects = [
  {
    name: 'Notes from the workshop',
    url: 'https://blog.brianbaldock.net',
    blurb: 'My blog. Security, AI infrastructure, and what building in the open actually teaches you.',
  },
  {
    name: 'AIgregator',
    url: 'https://aigregator.news',
    blurb: 'A daily AI news digest. Frontier-lab releases, policy, prediction markets, scored and cited.',
  },
  {
    name: 'GitHub',
    url: 'https://github.com/brianbaldock',
    blurb: 'Source for this course and everything else, including the labs you just ran.',
  },
];
---

<section class="other-projects" aria-labelledby="other-projects-heading">
  <h2 id="other-projects-heading">Elsewhere</h2>
  <ul>
    {projects.map((p) => (
      <li>
        <a href={p.url} rel="noopener noreferrer">{p.name}</a>
        <span class="blurb">{p.blurb}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .other-projects {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border, #2a2a2a);
  }
  .other-projects h2 {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted, #9a9a9a);
    margin: 0 0 0.8rem;
  }
  .other-projects ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .other-projects li {
    margin: 0;
    line-height: 1.45;
  }
  .other-projects a {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .blurb {
    display: block;
    font-size: 0.85rem;
    color: var(--text-muted, #9a9a9a);
    margin-top: 0.15rem;
  }
</style>
